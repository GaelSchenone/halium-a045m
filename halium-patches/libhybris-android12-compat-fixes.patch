diff --git a/compat/camera/Android.mk b/compat/camera/Android.mk
index 15fd848..32917d6 100644
--- a/compat/camera/Android.mk
+++ b/compat/camera/Android.mk
@@ -54,6 +54,9 @@ endif
 
 include $(BUILD_SHARED_LIBRARY)
 
